@model IEnumerable<IdentityRoleSystem.Models.ApplicationUser>
@{
    ViewData["Title"] = "Студенттер";
    var isAdmin = (bool)(ViewData["IsAdmin"] ?? false);
}
<section class="list-head">
    <div>
        <span class="eyebrow">ПАЙДАЛАНУШЫЛАР</span>
        <h1>Студенттер тізімі</h1>
    </div>
    <span class="count-badge">@Model.Count() студент</span>
</section>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="table-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Аты-жөні</th>
                    <th>Email</th>
                    <th>Рөл</th>
                    @if (isAdmin)
                    {
                        <th class="text-end">Әрекет</th>
                    }
                </tr>
            </thead>
            <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td><strong>@student.FullName</strong></td>
                    <td>@student.Email</td>
                    <td><span class="role-pill">Student</span></td>
                    @if (isAdmin)
                    {
                        <td class="text-end">
                            <form asp-action="Delete" method="post" onsubmit="return confirm('Студентті жою керек пе?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@student.Id" />
                                <button type="submit" class="btn btn-sm btn-danger">Жою</button>
                            </form>
                        </td>
                    }
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="@(isAdmin ? 4 : 3)" class="empty-state">Әзірге Student рөліндегі пайдаланушылар жоқ.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
